# syntax=docker/dockerfile:1.27@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
FROM --platform=$BUILDPLATFORM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS builder
ARG TARGETARCH

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -o /out/scribe-segmentor ./cmd/segmentor

FROM python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

ARG KRAKEN_PIP_SPEC=kraken==7.0.2
ARG KRAKEN_SEGMENTATION_MODEL_ID=kraken
ARG KRAKEN_SEGMENTATION_MODEL_DOI=10.5281/zenodo.14602569
ARG KRAKEN_SEGMENTATION_MODEL_FILE=blla.mlmodel
ARG KRAKEN_SEGMENTATION_MODEL_SHA256=77a638a83c9e535620827a09e410ed36391e9e8e8126d5796a0f15b978186056

ENV KRAKEN_MODEL_DIR=/models/kraken \
    KRAKEN_SEGMENTATION_MODEL_ID=${KRAKEN_SEGMENTATION_MODEL_ID} \
    KRAKEN_SEGMENTATION_MODEL=${KRAKEN_SEGMENTATION_MODEL_FILE}

ENV PADDLE_PDX_LOCAL_FONT_FILE_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

WORKDIR /app

COPY config/segmentor-requirements.lock /tmp/segmentor-requirements.lock

RUN sed -ri \
      's!URIs: http://deb.debian.org/debian$!URIs: http://snapshot.debian.org/archive/debian/20260720T000000Z!; s!URIs: http://deb.debian.org/debian-security$!URIs: http://snapshot.debian.org/archive/debian-security/20260720T000000Z!' \
      /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates=20230311+deb12u1 \
    curl=7.88.1-10+deb12u15 \
    fonts-dejavu-core=2.37-6 \
    imagemagick=8:6.9.11.60+dfsg-1.6+deb12u12 \
    libgomp1=12.2.0-14+deb12u1 \
    libgl1=1.6.0-1 \
    && rm -rf /var/lib/apt/lists/*

COPY config/imagemagick-policy.xml /etc/ImageMagick-6/policy.xml

# These Cloud Run services are CPU-only. The pip-compile output locks every
# Python transitive and accepted artifact hash, including the +cpu PyTorch
# wheels. A model/version change must regenerate the reviewed lock rather than
# letting a release build re-resolve mutable PyPI metadata.
RUN grep -Fqx "${KRAKEN_PIP_SPEC} \\" /tmp/segmentor-requirements.lock \
    && pip install --disable-pip-version-check --no-cache-dir \
      --require-hashes \
      --only-binary=:all: \
      --requirement /tmp/segmentor-requirements.lock \
    && rm -f /tmp/segmentor-requirements.lock

COPY scripts/install-kraken-models.sh /usr/local/bin/install-kraken-models
RUN chmod +x /usr/local/bin/install-kraken-models && install-kraken-models

# Pin the complete layout artifact; inference never downloads model weights.
RUN mkdir -p /models/pp-doclayout-v3 \
    && curl --fail --location --retry 3 https://huggingface.co/PaddlePaddle/PP-DocLayoutV3/resolve/241f8bdfc77a7c7bee915a5057aaee58c235a8d3/inference.json -o /models/pp-doclayout-v3/inference.json \
    && curl --fail --location --retry 3 https://huggingface.co/PaddlePaddle/PP-DocLayoutV3/resolve/241f8bdfc77a7c7bee915a5057aaee58c235a8d3/inference.yml -o /models/pp-doclayout-v3/inference.yml \
    && curl --fail --location --retry 3 https://huggingface.co/PaddlePaddle/PP-DocLayoutV3/resolve/241f8bdfc77a7c7bee915a5057aaee58c235a8d3/inference.pdiparams -o /models/pp-doclayout-v3/inference.pdiparams \
    && printf '%s\n' \
      '2b68367c5b312a03de5a6e1642c597c8f95165a7e40cd59c6700cf4a5042f4fd  /models/pp-doclayout-v3/inference.json' \
      '506fcfac13b3b546ae40d7886b44126420f392adb694e3f8bb6a6286a1f90fdc  /models/pp-doclayout-v3/inference.yml' \
      '70bd316b0582769ec968829fd1feb1a6a58b7c941b938327e551b6b12b45c137  /models/pp-doclayout-v3/inference.pdiparams' | sha256sum --check --strict

COPY --from=builder /out/scribe-segmentor /app/scribe-segmentor

RUN useradd --create-home --uid 10001 appuser && \
    chown -R appuser:appuser /app /models

USER appuser

# Exercise the native CPU runtime with the public readiness fixture before
# publishing the image. This catches missing libraries and inference failures.
COPY --chown=appuser:appuser config/readiness-smoke.png.base64 /tmp/layout-smoke.png.base64
RUN base64 -d /tmp/layout-smoke.png.base64 > /tmp/layout-smoke.png \
    && paddleocr layout_detection -i /tmp/layout-smoke.png \
      --model_name PP-DocLayoutV3 --model_dir /models/pp-doclayout-v3 \
      --device cpu --save_path /tmp/layout-smoke \
    && grep -q '"boxes"' /tmp/layout-smoke/*.json \
    && rm -rf /tmp/layout-smoke /tmp/layout-smoke.png /tmp/layout-smoke.png.base64

EXPOSE 8080
ENTRYPOINT ["/app/scribe-segmentor"]
