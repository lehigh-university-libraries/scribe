# syntax=docker/dockerfile:1.25@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
FROM golang:1.26-bookworm@sha256:5eec47a917f0a416d8899113528371c363538875d07934a822c1fbad9a0d6346 AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libleptonica-dev \
    libtesseract-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -tags localocr -o /out/scribe-segmentor ./cmd/segmentor

FROM python:3.14-slim-bookworm@sha256:a70519002c49552ea0a853de47599cf40479b001bd7a624f1112eaf44dcaccc7

ARG KRAKEN_PIP_SPEC=kraken==7.0
ARG KRAKEN_RECOGNITION_MODEL_DOI=10.5281/zenodo.10592716
ARG KRAKEN_RECOGNITION_MODEL_FILE=catmus-print-fondue-large.mlmodel
ARG KRAKEN_SEGMENTATION_MODEL_DOI=
ARG KRAKEN_SEGMENTATION_MODEL_FILE=

ENV KRAKEN_MODEL_DIR=/models/kraken \
    KRAKEN_TRANSCRIPTION_MODEL=${KRAKEN_RECOGNITION_MODEL_FILE} \
    KRAKEN_SEGMENTATION_MODEL=${KRAKEN_SEGMENTATION_MODEL_FILE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    imagemagick \
    libgomp1 \
    libleptonica-dev \
    libtesseract-dev \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "${KRAKEN_PIP_SPEC}"

COPY scripts/install-kraken-models.sh /usr/local/bin/install-kraken-models
RUN chmod +x /usr/local/bin/install-kraken-models && install-kraken-models

COPY --from=builder /out/scribe-segmentor /app/scribe-segmentor

RUN useradd --create-home --uid 10001 appuser && \
    chown -R appuser:appuser /app /models

USER appuser
EXPOSE 8080
ENTRYPOINT ["/app/scribe-segmentor"]
