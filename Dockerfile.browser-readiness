# Keep this image version identical to web's @playwright/test dependency and
# ci/test-browser.sh. The digest is part of the protected deployment source.
# renovate: datasource=docker depName=mcr.microsoft.com/playwright
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27 AS dependencies

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --prefer-offline --no-audit

FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27

WORKDIR /app

COPY --from=dependencies --chown=pwuser:pwuser /app/node_modules ./node_modules
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness-budget.mjs ./deployed-readiness-budget.mjs
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness-dom.mjs ./deployed-readiness-dom.mjs
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness-routing.mjs ./deployed-readiness-routing.mjs
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness-protojson.mjs ./deployed-readiness-protojson.mjs
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness-structure.mjs ./deployed-readiness-structure.mjs
COPY --chown=pwuser:pwuser web/e2e/deployed-readiness.mjs ./deployed-readiness.mjs
COPY --chown=pwuser:pwuser --chmod=0555 web/e2e/deployed-readiness-entrypoint.sh ./deployed-readiness-entrypoint.sh

USER pwuser

ENTRYPOINT ["/app/deployed-readiness-entrypoint.sh"]
