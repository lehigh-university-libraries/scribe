# syntax=docker/dockerfile:1.29@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS builder
WORKDIR /src
COPY cmd/cloudsql/main.go ./main.go
RUN CGO_ENABLED=0 go build -o /scribe-cloudsql ./main.go
FROM gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.28.0@sha256:e0cbea7b63455c1635d354ef456696d019dd02a5db47bf1994e849823e71ae89 AS cloudsql
FROM ghcr.io/libops/triplet:v1.3.2@sha256:3c7449cbc427e9f30cd8a11e1a5e5ea8ca63f00cf14b28e7000d26985312cd85
COPY --from=builder /scribe-cloudsql /app/scribe-cloudsql
COPY --from=cloudsql /cloud-sql-proxy /cloud-sql-proxy
COPY config/triplet-cloud-run.yaml /etc/triplet/cloud-run.yaml
CMD ["-config", "/etc/triplet/cloud-run.yaml"]
