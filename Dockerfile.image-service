FROM golang:1.26-alpine@sha256:f85330846cde1e57ca9ec309382da3b8e6ae3ab943d2739500e08c86393a21b1 AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/scribe-image-service ./cmd/image-service

FROM alpine:3.23@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11
WORKDIR /app
RUN apk add --no-cache \
    ca-certificates \
    imagemagick
RUN adduser -D -u 10001 appuser
COPY --from=builder /out/scribe-image-service /app/scribe-image-service
USER appuser
EXPOSE 8080
ENTRYPOINT ["/app/scribe-image-service"]
