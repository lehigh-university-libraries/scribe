# This compose env file is only for local image pinning. Non-secret runtime
# config lives in config.yaml. Local-only secret fallbacks such as VAULT_TOKEN
# can be exported in your shell if you are not running on GCP.

# Image tag used by docker compose.
SCRIBE_API_IMAGE=scribe-api:local
SCRIBE_FRONTEND_IMAGE=scribe-frontend:local
# One reviewed value scopes every persistent Compose volume. Changing this
# starts a clean local data generation while retaining prior volumes.
SCRIBE_DATA_GENERATION=canonical-v1
# Optional local fallback when not using GCP Vault auth:
# VAULT_TOKEN=
# SCRIBE_PAGE_TOKEN_SIGNING_KEY is generated in
# secrets/page_token_signing_key and must not be stored in this file.
# TRIPLET_SOURCE_READ_TOKEN is generated in
# secrets/triplet_source_read_token and must not be stored in this file.
#
# If local docker compose is talking to a deployed Vault, set the workspace-
# specific GCP auth role that Terraform created, for example:
# VAULT_GCP_AUTH_ROLE=scribe-app-dev
# or
# VAULT_GCP_AUTH_ROLE=scribe-app-prod

# Local OCR helper services. docker-compose.override-example.yaml starts these
# automatically and points the API/worker at them.
# OLLAMA_MODEL_ENDPOINTS_JSON={"glm-ocr:bf16":{"url":"https://ollama-glm.example","audience":"https://ollama-glm.example"}}
# SEGMENTATION_SERVICE_URL=http://segmentor:8080
# SEGMENTATION_MODEL_ENDPOINTS_JSON={"kraken":{"url":"http://segmentor:8080","audience":""}}
# IIIF_SOURCE_BASE=http://api:8080/static/uploads
# IIIF_MAX_MANIFEST_CANVASES=500
# IIIF_MAX_MANIFEST_IMPORT_BYTES=67108864
# TRANSCRIPTION_MAX_ACTIVE_JOBS_PER_WORKSPACE=1000
# TRANSCRIPTION_MAX_SEGMENTS_PER_JOB=50
# STORAGE_MAX_BYTES_PER_WORKSPACE=5368709120
# STORAGE_MAX_BYTES_TOTAL=32212254720
# STORAGE_MAX_ITEMS_PER_WORKSPACE=5000
# STORAGE_MAX_ITEMS_TOTAL=50000
# STORAGE_MAX_IMAGES_PER_WORKSPACE=10000
# STORAGE_MAX_IMAGES_TOTAL=100000
# STORAGE_RESERVATION_TTL=6h
# STORAGE_NORMALIZATION_CACHE_MAX_BYTES=2147483648
# STORAGE_NORMALIZATION_CACHE_MAX_AGE=168h
# SEGMENTOR_MAX_CONCURRENCY=1
# The application trusts forwarding headers only from the fixed Traefik
# container. If the bridge is changed, update all three values together.
# SCRIBE_COMPOSE_SUBNET=172.30.0.0/24
# SCRIBE_TRAEFIK_IP=172.30.0.2
# SERVER_TRUSTED_PROXY_CIDRS=172.30.0.2/32
# Local direct callers are deliberately not trusted to supply forwarding
# headers. Terraform replaces this with the exact Cloud Run/VPC subnet.
# TRAEFIK_FORWARDED_TRUSTED_IPS=127.0.0.1/32
# KRAKEN_MODEL=catmus-print-fondue-large.mlmodel
# KRAKEN_MODEL_ENDPOINTS_JSON={"catmus-print-fondue-large.mlmodel":{"url":"http://segmentor:8080","audience":""}}
