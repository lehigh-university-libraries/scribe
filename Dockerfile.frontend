# syntax=docker/dockerfile:1.25@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
FROM node:24-alpine@sha256:156b55f92e98ccd5ef49578a8cea0df4679826564bad1c9d4ef04462b9f0ded6 AS web-build

WORKDIR /app
COPY mirador-scribe/ /app/mirador-scribe/

WORKDIR /app/web
COPY web/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --prefer-offline --no-audit --progress=false

COPY web/ ./
RUN npm run build

FROM node:24-alpine@sha256:156b55f92e98ccd5ef49578a8cea0df4679826564bad1c9d4ef04462b9f0ded6

WORKDIR /app/web
ENV NODE_ENV=production
ARG SCRIBE_FRONTEND_BACKEND_ORIGIN=""
ARG SCRIBE_FRONTEND_IIIF_ORIGIN=""
ENV SCRIBE_FRONTEND_BACKEND_ORIGIN=${SCRIBE_FRONTEND_BACKEND_ORIGIN}
ENV SCRIBE_FRONTEND_IIIF_ORIGIN=${SCRIBE_FRONTEND_IIIF_ORIGIN}

COPY --from=web-build /app/web/dist /app/web/dist
COPY web/server.mjs /app/web/server.mjs

EXPOSE 8888
USER node
CMD ["node", "server.mjs"]
