{
  "name": "mirador-scribe",
  "version": "0.1.0",
  "description": "Text-first OCR editing plugin for Mirador 4 backed by IIIF AnnotationPages",
  "type": "module",
  "main": "dist/mirador-scribe.cjs",
  "module": "dist/mirador-scribe.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mirador-scribe.mjs",
      "require": "./dist/mirador-scribe.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run check:types && CI=true vite build && npm run check:package-types && npm run check:packed-types && node scripts/package-smoke.mjs",
    "check:package-types": "tsc -p test-dts/tsconfig.json",
    "check:packed-types": "node scripts/package-type-smoke.mjs",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "vite",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "i18next": ">=25",
    "mirador": "^4.0.0",
    "openseadragon": ">=5",
    "prop-types": "^15.8.1",
    "react": ">=19",
    "react-dom": ">=19",
    "react-i18next": ">=15"
  },
  "dependencies": {
    "@mui/icons-material": "7.3.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "20.11.0",
    "openseadragon": "6.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vite": "7.3.6"
  }
}
